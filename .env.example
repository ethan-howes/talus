# Talus .env

# db info
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talus
POSTGRES_USER=talus_app
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# paths
CUDA_TERRAIN_BINARY_PATH=
DEM_STORAGE_PATH=/data/dem
WEB_STATIC_DIR=./web

 # service listening ports
S1_LISTEN_PORT=8081
S2_LISTEN_PORT=8082
S4_LISTEN_PORT=8084
S5_LISTEN_PORT=8080

# service endpoints
S1_INGESTION_ENDPOINT=http://ingestion:8081
S2_TERRAIN_ENDPOINT=http://terrain:8082
S4_HAZARD_ENDPOINT=http://hazard:8084

# terrain analysis vars
TERRAIN_SLOPE_THRESHOLD_DEG=45
TERRAIN_TRI_THRESHOLD=5
TERRAIN_TILE_HALO_METERS=30
TERRAIN_TILE_MAX_CELLS_PER_SIDE=4000
SOURCE_ZONE_PROXIMITY_RADIUS_M=500

# logs
LOG_LEVEL=info
